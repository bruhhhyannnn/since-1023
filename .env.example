# From Supabase → Connect (Next.js / App Router). Safe to be public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# From Supabase → Project Settings → API Keys → Secret keys. Keep this private.
# Leave it empty on your computer to keep test photos in ./.data instead of the real albums.
SUPABASE_SECRET_KEY=

# Who can sign in and edit: your Supabase Auth emails, separated by commas.
OWNER_EMAILS=
